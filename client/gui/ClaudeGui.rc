/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON    DISCARDABLE     "..\\..\\build\\icons\\client.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

// 0x2000 on IDC_OUTPUT is ES_DISABLENOSCROLL (richedit.h): always show the
// scrollbar
IDD_CLAUDEGUI_DIALOG DIALOGEX 0, 0, 400, 250
STYLE DS_CENTER | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE |
    WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "ClaudeWin9x"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Server:",IDC_LABEL_SERVER,7,9,26,8
    EDITTEXT        IDC_SERVER_IP,34,7,70,12,ES_AUTOHSCROLL
    LTEXT           ":",IDC_LABEL_COLON,107,9,4,8
    EDITTEXT        IDC_SERVER_PORT,113,7,30,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "&Connect",IDC_CONNECT,151,6,50,14
    CONTROL         "&Auto-approve tools",IDC_AUTO_APPROVE,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,209,8,80,10
    CONTROL         "",IDC_OUTPUT,"RICHEDIT",ES_MULTILINE | ES_AUTOVSCROLL |
                    ES_READONLY | 0x2000 | WS_BORDER |
                    WS_VSCROLL | WS_TABSTOP,7,27,386,160
    EDITTEXT        IDC_INPUT,7,193,329,40,ES_MULTILINE | ES_AUTOVSCROLL |
                    ES_WANTRETURN | WS_VSCROLL
    PUSHBUTTON      "S&end",IDC_SEND,343,193,50,14
    PUSHBUTTON      "C&lear",IDC_CLEAR,343,219,50,14
    LTEXT           "Not connected",IDC_STATUS,7,238,386,8,SS_NOPREFIX
END

IDD_APPROVAL DIALOG DISCARDABLE  0, 0, 300, 170
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tool Approval Required"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Claude wants to use a tool on this machine:",
                    IDC_LABEL_TOOL,7,7,286,8
    LTEXT           "",IDC_TOOL_NAME,7,19,286,8,SS_NOPREFIX
    EDITTEXT        IDC_TOOL_INPUT,7,31,286,110,ES_MULTILINE |
                    ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "&Allow",IDOK,183,149,50,14
    DEFPUSHBUTTON   "&Deny",IDCANCEL,243,149,50,14
END


