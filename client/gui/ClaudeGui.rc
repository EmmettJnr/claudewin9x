            VALUE "InternalName", "ClaudeWin9xGui\0"
            VALUE "LegalCopyright", "Ryan Deering\0"
            VALUE "OriginalFilename", "ClaudeWin9x-Gui.exe\0"
            VALUE "ProductName", "Claude Code Win9x/NT Client\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
