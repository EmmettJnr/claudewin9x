/*
 * ClaudeRemote.rc - Resources for the remote control client
 */

#include <windows.h>
#include "resource.h"

IDR_MAINFRAME ICON "../../build/icons/client.ico"

IDD_REMOTE DIALOG 0, 0, 300, 196
STYLE DS_CENTER | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION |
    WS_SYSMENU
CAPTION "ClaudeWin9x Remote"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Server:",IDC_LABEL_SERVER,7,9,26,8
    EDITTEXT        IDC_SERVER_IP,34,7,70,12,ES_AUTOHSCROLL
    LTEXT           ":",IDC_LABEL_COLON,107,9,4,8
    EDITTEXT        IDC_SERVER_PORT,113,7,30,12,ES_AUTOHSCROLL | ES_NUMBER
    PUSHBUTTON      "&Connect",IDC_CONNECT,243,6,50,14
    CONTROL         "&Allow anything (run commands and write files without asking)",
                    IDC_ALLOW_ALL,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,
                    7,26,286,10
    LTEXT           "Status:",IDC_LABEL_STATUS,7,43,26,8
    LTEXT           "Not connected",IDC_STATUS,34,43,259,8,SS_NOPREFIX
    LTEXT           "Activity:",IDC_LABEL_LOG,7,58,40,8
    EDITTEXT        IDC_LOG,7,69,286,101,ES_MULTILINE | ES_AUTOVSCROLL |
                    ES_READONLY | WS_VSCROLL
    PUSHBUTTON      "C&lear",IDC_CLEAR,243,175,50,14
END

IDD_APPROVAL DIALOG 0, 0, 300, 170
STYLE DS_MODALFRAME | DS_CENTER | DS_SETFOREGROUND | WS_POPUP | WS_CAPTION |
    WS_SYSMENU
CAPTION "Claude wants to make a change"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Claude (remote) wants to do this on this machine:",
                    IDC_LABEL_TOOL,7,7,286,8
    LTEXT           "",IDC_TOOL_NAME,7,19,286,8,SS_NOPREFIX
    EDITTEXT        IDC_TOOL_INPUT,7,31,286,110,ES_MULTILINE |
                    ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL | WS_HSCROLL |
                    ES_AUTOHSCROLL
    PUSHBUTTON      "&Allow",IDOK,183,149,50,14
    DEFPUSHBUTTON   "&Deny",IDCANCEL,243,149,50,14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ryan Deering\0"
            VALUE "FileDescription", "Remote control client for Claude Code on Windows 9x/NT systems\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "ClaudeWin9xRemote\0"
            VALUE "LegalCopyright", "Ryan Deering\0"
            VALUE "OriginalFilename", "ClaudeWin9x-Remote.exe\0"
            VALUE "ProductName", "Claude Code Win9x/NT Client\0"
            VALUE "ProductVersion", "1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
